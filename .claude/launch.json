{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "walkpets-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8084"],
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api"
      },
      "port": 8084
    },
    {
      "name": "walkpets-web-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8083"],
      "env": { "EXPO_PUBLIC_DATA_SOURCE": "mock" },
      "port": 8083
    }
  ]
}
