# WalkPets API — variables de entorno
# Copiá este archivo a `.env` y completá valores reales. Nunca commitees `.env`.

# Puerto HTTP del backend
PORT=3000

# Conexión a MongoDB (local o Atlas)
# Local: mongodb://127.0.0.1:27017/walkpets
# Atlas: mongodb+srv://<usuario>:<clave>@<cluster>/walkpets?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/walkpets

# Secreto para firmar los JWT. Usá una cadena larga y aleatoria en producción.
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS (separados por coma). Vacío = todos en desarrollo.
CORS_ORIGIN=

# Contraseña para las cuentas de demostración creadas por `npm run seed`.
# No se usa en runtime; solo la lee el script de seed. Mínimo 8 caracteres.
# SEED_PASSWORD=
