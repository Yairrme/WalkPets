# WalkPets — variables de entorno del frontend (Expo)
# Copiá este archivo a `.env` y ajustá los valores. Nunca commitees `.env`.
#
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al bundle de la app.
# Nunca pongas secretos, claves privadas ni credenciales reales acá.

# Fuente de datos: `mock` (por defecto, sin backend) o `api` (NestJS + MongoDB).
EXPO_PUBLIC_DATA_SOURCE=mock

# Base de la API, incluyendo el prefijo /api y sin barra final.
# - Web / simulador iOS: http://localhost:3000/api
# - Emulador Android:    http://10.0.2.2:3000/api
# - Celular físico:      http://<IP-LAN-de-tu-PC>:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Timeout de cada request en milisegundos.
EXPO_PUBLIC_API_TIMEOUT_MS=10000
